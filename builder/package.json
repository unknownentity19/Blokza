{
  "name": "blokza-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BLOKZA visual website builder — production editor",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "build:only": "vite build",
